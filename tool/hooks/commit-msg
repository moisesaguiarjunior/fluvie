#!/usr/bin/env bash
# Conventional Commits. Delegates to the upstream hook when this checkout
# still has .githooks, and keeps the same rule when it does not (hook fixtures).
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
if [ -f "$root/.githooks/commit-msg" ]; then
  exec "$root/.githooks/commit-msg" "$@"
fi

MSG_FILE="${1:?commit message file required}"
header="$(head -n1 "$MSG_FILE")"
regex='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9_.-]+\))?(!)?: .+$'
if [[ ! "$header" =~ $regex ]]; then
  echo "✗ commit message must follow Conventional Commits:"
  echo "    <type>(<scope>): <subject>"
  echo "  types: feat fix docs style refactor perf test build ci chore revert"
  echo "  got:  $header"
  exit 1
fi
if [ "${#header}" -gt 72 ]; then
  echo "⚠ subject is ${#header} chars (>72) — consider shortening."
fi
